{
  "name": "ConTemplo PAX",
  "short_name": "ConTemplo PAX",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FBF7F2",
  "theme_color": "#FBF7F2",
  "icons": [
    { "src": "icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icono-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "contactos", "accept": ["text/x-vcard", "text/vcard", "text/directory", ".vcf"] }
      ]
    }
  }
}
